# --- Anthropic / Claude Vision ---
# Anthropic does NOT support OAuth for arbitrary 3rd-party apps (Feb 2026 policy
# change restricted OAuth to Claude.ai + Claude Code only). Provide a personal
# API key here. The key only lives on your machine; it is never sent anywhere
# except to api.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Vision model (override if you want to try a different one)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Sheets (OAuth) ---
# Path to the OAuth client_secret.json downloaded from Google Cloud Console.
# Create an "OAuth 2.0 Client ID" of type "Desktop app" and save the JSON here.
GOOGLE_OAUTH_CLIENT_SECRETS=./data/google_client_secret.json

# Spreadsheet ID of your Google Sheet (the long string in the sheet URL).
# Leave blank on first run -- the app will offer to create one for you.
GOOGLE_SHEET_ID=

# --- Local xlsx mirror ---
# The existing tracker is mirrored to here on every save (failsafe / offline).
LOCAL_XLSX_PATH=/Users/connor.leh/Documents/Personal Finances/Baseball_Cards.xlsx

# --- eBay Sell API ---
# Phase 1 (sandbox) is the default. Get a sandbox keyset instantly at
# https://developer.ebay.com/my/keys (no approval needed). Phase 2 = same code,
# swap EBAY_ENV=production once eBay approves your production keyset.
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_RUNAME=                  # the eBay "RuName" (redirect URL identifier)
# Default seller-policy IDs (set after Connor creates them on eBay once)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=cardscanner_default

# --- Comp lookup ---
# Set to true to skip eBay comp lookups entirely (cards save with ID only).
# Flip to false once a new pricing API is configured.
SKIP_COMP_LOOKUP=true

# --- Pricing strategy ---
# When the comp source is the Browse API (active listings), suggested price
# is min(active) × (1 - PRICING_UNDERCUT_PCT/100). Typical range 5-7.
PRICING_UNDERCUT_PCT=6.0

# --- Vision backend ---
# "auto" = CLI if available, else HTTP (original behavior)
# "ollama" = local Ollama server (falls back to Claude on failure)
# "http" = Anthropic API directly
# "cli" = Claude Code CLI
VISION_BACKEND=auto

# --- Ollama (local vision model) ---
OLLAMA_BASE_URL=http://100.71.106.53:11434
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# --- Captcha notifications (ntfy.sh) ---
# Install the ntfy app on your phone, subscribe to your topic, and get push
# notifications with a screenshot when the server hits a captcha.
# Leave NTFY_TOPIC blank to disable notifications.
NTFY_TOPIC=cardscanner-connor
NTFY_SERVER=https://ntfy.sh

# --- Server ---
HOST=127.0.0.1
PORT=8765
